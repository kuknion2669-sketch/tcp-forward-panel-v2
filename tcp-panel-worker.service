[Unit]
Description=TCP Forward Panel v2 background worker (stats + auto-disable + reconcile)
Documentation=file:///root/tcp-panel-v2/panelworker.py
After=network.target haproxy.service tcp-panel-v2.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/tcp-panel-v2
Environment="PANEL_PYTHON=/usr/bin/python3"
ExecStart=/root/tcp-panel-v2/start_worker.sh
TimeoutStartSec=180
# 拿不到锁就直接退出（已有另一份在跑），所以偶尔撞车不算失败
SuccessExitStatus=0 3
